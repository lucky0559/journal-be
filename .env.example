PORT=3000
# Neon: Project > Connect > pooled connection string (ends with ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Any random string of 32+ characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
# The SAME Web OAuth client ID the mobile app uses (EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID)
GOOGLE_WEB_CLIENT_ID=
# Cloudflare R2 (S3-compatible) bucket for photos and voice notes
R2_BUCKET=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
