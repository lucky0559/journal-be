PORT=3000
# Neon: Project > Connect > pooled connection string (ends with ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Any random string of 32+ characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
# The SAME Web OAuth client ID the mobile app uses (EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID)
GOOGLE_WEB_CLIENT_ID=
# Cloudinary (free plan) for photos and voice notes.
# Cloudinary dashboard > Settings > API Keys > copy the "API environment variable" value (cloudinary://KEY:SECRET@CLOUD_NAME)
CLOUDINARY_URL=
